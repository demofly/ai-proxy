@startuml TD-Shared-codeployment
!theme plain
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

title Разделение узла между проектами: осмотр, доля памяти, уступчивость

start

:Прогон развёртывания начался;

partition "Осмотр узла (каждый прогон)" {
  :Прочитать каталоги расширения nginx:
  stream.d, sni-map.d, conf.d;
  :Отбросить собственные файлы
  (перечислены поимённо);
  if (остались чужие файлы?) then (да)
    :признак совместного размещения = истина;
  else (нет)
    :признак = ложь;
  endif
}

if (совместное размещение?) then (да)

  partition "Бюджет памяти по объявленной доле" {
    if (проект ведущий (ai-proxy)?) then (да)
      :доля = 35 % памяти узла;
    else (ведомый)
      :доля = 50 % памяти узла;
      if (сумма неснижаемых пределов > доли?) then (да)
        :взять сумму неснижаемых;
        :напечатать предупреждение
        о превышении доли;
      endif
    endif
    if (сумма пределов служб помещается?) then (нет)
      :ОТКАЗ развёртывания
      с перечнем вариантов;
      stop
    endif
  }

  partition "Общие ресурсы узла" {
    if (проект ведущий?) then (да)
      :перезаписать общий маршрутизатор;
      :задать worker_connections
      и worker_rlimit_nofile;
      note right
        Значение покрывает нагрузку
        ВСЕХ проектов узла: уступивший
        сосед восполнить нехватку
        не может — строка в файле одна.
      end note
    else (ведомый)
      if (общий маршрутизатор существует?) then (да)
        :пропустить — оставить владельцу;
      else (нет)
        :развернуть свою редакцию
        с согласованными таймингами;
        note right
          Временная, до прогона ведущего.
          Ломать соседа ею нельзя: предел
          простоя выше, чем у его цепочки,
          своё ограничение соединений снято.
        end note
      endif
      :пропустить пределы nginx
      и настройку экрана;
    endif
  }

else (нет)
  :бюджет = память узла
  за вычетом резерва ядра (25 %);
  :распоряжаться узлом
  как единственный владелец;
endif

:Развернуть собственные файлы
в точках расширения;

stop

@enduml
