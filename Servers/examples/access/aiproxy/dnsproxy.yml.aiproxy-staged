# Ansible managed
# Local transport bridge only. Caching and DNSSEC validation remain in Unbound.
listen-addrs: [127.0.0.1]
listen-ports: [5353]
# Static DoH endpoint: https://dns.transit.internal/q via dns.transit.internal:443:198.51.100.11
# Static DoH endpoint: https://dns.transit.internal/q via dns.transit.internal:443:198.51.100.12
upstream: ["sdns://AgAAAAAAAAAADTE5OC41MS4xMDAuMTEAFGRucy50cmFuc2l0LmludGVybmFsAi9x", "sdns://AgAAAAAAAAAADTE5OC41MS4xMDAuMTIAFGRucy50cmFuc2l0LmludGVybmFsAi9x"]
# All endpoints are literal IPs: no DNS bootstrap or plaintext fallback.
# The pinned v0.86.0 HTTP/2 transport pools connections with a 300s idle timeout.
# Upstream Unbound enforces TLS 1.3; do not confuse server-side tls-min-version
# in dnsproxy with its outgoing DoH transport options.
bootstrap: []
fallback: []
insecure: true
http3: false
cache: false
hosts-file-enabled: false
pending-requests-enabled: true
max-go-routines: 64
timeout: 4s
upstream-mode: parallel
dnssec: true
