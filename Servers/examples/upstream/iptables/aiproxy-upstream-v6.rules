# Ansible managed
# IPv6 counterpart of the private upstream chain. IPv4 access addresses do not
# authorize IPv6 sources. Leave SSH, ICMPv6 and foreign services to host policy.
*filter
:SQUID-PROXY - [0:0]
-A SQUID-PROXY -i lo -j RETURN
-A SQUID-PROXY -p tcp --dport 443 -j DROP
-A SQUID-PROXY -p tcp --dport 53 -j DROP
-A SQUID-PROXY -p tcp --dport 8443 -j DROP
-A SQUID-PROXY -p udp --dport 53 -j DROP
-A SQUID-PROXY -j RETURN
COMMIT
