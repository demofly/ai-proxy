# {{ ansible_managed }}
# IPv6 counterpart of the private upstream chain. IPv4 access addresses do not
# authorize IPv6 sources. Leave SSH, ICMPv6 and foreign services to host policy.
*filter
:{{ squid_chain }} - [0:0]
-A {{ squid_chain }} -i lo -j RETURN
{% for host in groups['access_proxies'] %}
{% if ':' in hostvars[host]['ansible_host'] %}
-A {{ squid_chain }} -s {{ hostvars[host]['ansible_host'] }} -p tcp --dport {{ proxy_port }} -j ACCEPT
{% if mtproxy_enabled | default(false) | bool and proxy_port | int != 443 %}
-A {{ squid_chain }} -s {{ hostvars[host]['ansible_host'] }} -p tcp --dport 443 -j ACCEPT
{% endif %}
{% endif %}
{% endfor %}
{% for client in dns_allowed_clients | default([]) if ':' in client %}
-A {{ squid_chain }} -s {{ client }} -p tcp --dport {{ (proxy_port if nginx_on_443 | default(behind_nginx | default(true)) | bool else dns_doh_backend_port | default(8443)) | int }} -j ACCEPT
{% endfor %}
{% for port in ([proxy_port | int, 53, dns_doh_backend_port | default(8443) | int] + ([443] if mtproxy_enabled | default(false) | bool else [])) | unique %}
-A {{ squid_chain }} -p tcp --dport {{ port }} -j DROP
{% endfor %}
-A {{ squid_chain }} -p udp --dport 53 -j DROP
-A {{ squid_chain }} -j RETURN
COMMIT
