#!/usr/sbin/nft -f
# nftables Configuration - Upstream Proxy
# Managed by Ansible - DO NOT EDIT MANUALLY
# Host: {{ inventory_hostname }} ({{ ansible_host }})
#
# Atomically replace reserved owner chains/set, preserving all other objects.
# Never delete the shared table: foreign chains may live in inet filter too.
add table inet filter
add set inet filter dns_clients { type ipv4_addr; }
flush set inet filter dns_clients
add chain inet filter matrix_services
flush chain inet filter matrix_services
add chain inet filter input { type filter hook input priority 0; policy drop; }
flush chain inet filter input
add chain inet filter forward { type filter hook forward priority 0; policy drop; }
flush chain inet filter forward
add chain inet filter output { type filter hook output priority 0; policy accept; }
flush chain inet filter output

table inet filter {
    # DNS clients of the local resolver (unbound) - access nodes only.
    # Source of truth: dns_allowed_clients (playbook.yml) = group access_proxies
    # + dns_extra_clients. A named set instead of one rule per IP: the effective
    # client list is auditable with `nft list set inet filter dns_clients`.
    set dns_clients {
        type ipv4_addr
{% if dns_allowed_clients | default([]) | length > 0 %}
        elements = { {{ dns_allowed_clients | join(', ') }} }
{% endif %}
    }

    chain matrix_services {
        include "/etc/shared-host/matrix-ports.nft"
    }

    chain input {
        type filter hook input priority 0; policy drop;

        jump matrix_services comment "Matrix shared ports"

        # Allow established/related connections
        # (includes replies to unbound's own outgoing DNS queries)
        ct state established,related accept

        # Allow loopback (Squid resolves through 127.0.0.1:53)
        iif "lo" accept

        # Allow SSH
        tcp dport 22 accept

        # Allow Squid only from access proxies
{% for host in groups['access_proxies'] %}
        ip saddr {{ hostvars[host]['ansible_host'] }} tcp dport {{ proxy_port }} accept
{% endfor %}

        # Allow DNS (unbound) from access proxies - both transports
        ip saddr @dns_clients tcp dport 53 accept comment "DNS from access proxies"
        ip saddr @dns_clients udp dport 53 accept comment "DNS from access proxies"

        # Explicit deny for every other source. Redundant with `policy drop`, but
        # it gives a hit counter and makes the restriction visible in `nft list ruleset`.
        tcp dport 53 counter drop comment "DNS deny: not an access proxy"
        udp dport 53 counter drop comment "DNS deny: not an access proxy"

{% if mtproxy_enabled | default(false) | bool %}
        # Allow MTProxy TLS (nginx on 443) from access proxies
{% for host in groups['access_proxies'] %}
        ip saddr {{ hostvars[host]['ansible_host'] }} tcp dport 443 accept
{% endfor %}
{% endif %}

        # Allow ICMP ping
        icmp type echo-request accept
        icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
        # IPv6 neighbor discovery must survive neighbor-cache expiry.
        ip6 hoplimit 255 icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

        # Log dropped packets (optional, uncomment if needed)
        # log prefix "nftables dropped: " flags all counter
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
