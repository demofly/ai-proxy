# {{ ansible_managed }}
# Общий маршрутизатор SNI для порта 443 (контекст stream).
# Файл принадлежит проекту ai-proxy и перезаписывается им при каждом развёртывании.
# ПРАВКА ВРУЧНУЮ И ИЗ ДРУГИХ ПРОЕКТОВ БЕССМЫСЛЕННА — изменения будут затёрты.
#
# Устройство: nginx stream читает имя SNI из TLS ClientHello без терминации
# и направляет TCP-соединение целиком на подошедший upstream.
#
# Точки расширения для других проектов узла (свой файл под своим префиксом,
# чужие файлы не читаются и не правятся):
#   /etc/nginx/stream.d/sni-map.d/*.conf — записи карты имён SNI (включены в map{} ниже)
#   /etc/nginx/stream.d/*.conf          — собственные потоковые блоки (upstream, server)
#   /etc/nginx/conf.d/*.conf            — виртуальные хосты HTTP (контекст http{})

# ============================================================================
# Журнал маршрутизации
# ============================================================================
# В потоковом режиме журнал обращений по умолчанию выключен, и без этих строк
# успешная маршрутизация нигде не фиксируется: видны только отказы в журнале ошибок.
#
# ЦЕНА ВКЛЮЧЕНИЯ названа прямо: записываются запрашиваемые имена, то есть узел
# начинает хранить след того, к каким сервисам обращались. Это ослабляет
# неразличимость обращений — свойство, ради которого построена двухуровневая цепочка.
# Включено решением владельца ради разбора происшествий и работы обнаружения вторжений.
#
# Вид записи подогнан под парсер `crowdsecurity/nginx-logs` действующей коллекции:
# парсера для потокового режима не существует, а собственный потребовал бы сопровождения.
# Отсюда подстановка: запрошенное имя SNI занимает место цели запроса, адрес
# назначения — место источника перехода. Поля потокового режима в шаблоне разбора
# отсутствуют, а терять сведения незачем.
log_format sni_router '$remote_addr - - [$time_local] '
                      '"CONNECT $ssl_preread_server_name HTTP/1.1" '
                      '$status $bytes_sent "$upstream_addr" "-"';

access_log {{ sni_router_access_log | default('/var/log/nginx/sni-router.log') }} sni_router{{ ' buffer=32k flush=5s' if (sni_router_log_buffered | default(true) | bool) else '' }};

# ============================================================================
# SNI-based routing map
# ============================================================================
map $ssl_preread_server_name $sni_backend {
    include /etc/nginx/stream.d/sni-map.d/*.conf;
    default fallback_squid;
}

# ============================================================================
# Fallback upstream: local Squid (or any default handler on 127.0.0.1:3128)
# ============================================================================
upstream fallback_squid {
    server 127.0.0.1:3128;
}

# ============================================================================
# SSL preread server (port 443, no TLS termination)
# ============================================================================
server {
    listen 443;
    listen [::]:443;

    ssl_preread on;
    proxy_pass $sni_backend;

    # Pass real client IP to backends via PROXY protocol (HAProxy v1)
    # Backends must accept proxy_protocol (nginx: listen ... proxy_protocol; squid: require-proxy-header)
    proxy_protocol on;

    # Ограничение числа одновременных соединений с одного адреса здесь не задаётся
    # и является решением проекта: на upstream-узлы соединения приходят только
    # с адресов access-узлов, ограниченных межсетевым экраном, а ограничение темпа
    # выполняется на access-уровне.
    #
    # Соседний проект, которому предел нужен, кладёт свои директивы в подключаемый
    # каталог ниже: собственного блока на порту 443 у него быть не может — порт один
    # и занят этим маршрутизатором. Зона счётчика (limit_conn_zone) объявляется
    # на уровне потокового блока, то есть отдельным файлом в stream.d/.
    include /etc/nginx/stream.d/router.d/*.conf;

    # Timeouts: max of all co-deployed projects' requirements
    # 1800s = 30 min (Squid chain: AI API can "think" up to 30 minutes)
    # MTProxy chain uses shorter timeouts (60s) in its own stream blocks
    proxy_connect_timeout 10s;
    # Предел простоя маршрутизатора держится ВЫШЕ предела Squid (час по
    # требованию владельца): цепочку рвёт наименьший таймер, и рвать её
    # должен Squid — он единственный в цепочке различает паузу в обмене
    # и смерть вышестоящего узла, и пишет об этом в журнал.
    proxy_timeout 3900s;

    # TCP keepalive: detect dead peers via kernel probes
    proxy_socket_keepalive on;

    # TCP optimization
    # Буфер потокового прокси — по одному на направление на каждое соединение.
    # 16k держали ради полного TLS-записи; при бюджете памяти узла это давало
    # 32 КБ на соединение и десятки мегабайт на пике. 4k — минимально разумное:
    # запись читается несколькими порциями, память на соединение падает вчетверо.
    proxy_buffer_size 4k;
}
