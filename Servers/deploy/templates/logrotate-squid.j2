# {{ ansible_managed }}
# This is the single Squid entry, replacing the distribution's same-named file.
/var/log/squid/*.log {
    {{ squid_log_rotate_period | default('daily') }}
    rotate {{ squid_log_rotate_keep | default(14) }}
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su proxy proxy
}
