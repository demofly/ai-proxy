# {{ ansible_managed }}
# Client HTTPS proxy; the public SNI router already prepends PROXY protocol.
upstream aiproxy_https_proxy {
    server 127.0.0.1:{{ https_proxy_local_port | default(4445) | int }};
}

server {
    listen 127.0.0.1:{{ https_proxy_local_port | default(4445) | int }} ssl proxy_protocol;
    # Restore the client address only on access; upstream transit stays anonymous.
    set_real_ip_from 127.0.0.1;
    ssl_certificate {{ https_proxy_certificate | default('/etc/letsencrypt/live/' ~ https_proxy_hostname ~ '/fullchain.pem') }};
    ssl_certificate_key {{ https_proxy_certificate_key | default('/etc/letsencrypt/live/' ~ https_proxy_hostname ~ '/privkey.pem') }};
    ssl_protocols TLSv1.2 TLSv1.3;
    # Squid receives HTTP/1.1 CONNECT. HTTP/2 inside the tunnel is independent.
    ssl_alpn http/1.1;
    ssl_handshake_timeout 10s;
    ssl_session_cache shared:aiproxy_https:128k;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    limit_conn aiproxy_transit {{ proxy_effective_max_connections | default(proxy_max_connections | default(96)) | int }};
    proxy_pass 127.0.0.1:{{ squid_local_port | default(3128) | int }};
    proxy_protocol on;
    proxy_connect_timeout 10s;
    proxy_timeout {{ [3900, (read_timeout | default('1 hour') | squid_duration_seconds) + 300] | max }}s;
    proxy_socket_keepalive on;
    proxy_buffer_size 4k;
}
