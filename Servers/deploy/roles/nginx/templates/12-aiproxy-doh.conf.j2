# {{ ansible_managed }}
upstream aiproxy_doh {
    server 127.0.0.1:{{ dns_doh_tls_port | default(4446) | int }};
}
server {
    listen 127.0.0.1:{{ dns_doh_tls_port | default(4446) | int }} ssl proxy_protocol;
    set_real_ip_from 127.0.0.1;
    ssl_certificate /etc/letsencrypt/live/{{ dns_doh_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ dns_doh_hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_alpn h2;
    ssl_handshake_timeout 10s;
    ssl_session_cache shared:aiproxy_doh:128k;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    # Public DoH: no client allowlist, authentication or per-address restriction.
    # Strip the router's PROXY header; Unbound receives raw HTTP/2 on loopback.
    proxy_pass 127.0.0.1:{{ dns_doh_local_port | default(5443) | int }};
    proxy_protocol off;
    proxy_connect_timeout 3s;
    proxy_timeout 60s;
    proxy_socket_keepalive on;
    proxy_buffer_size 4k;
}
