# {{ ansible_managed }}
# Терминация TLS 1.3 для MTProxy (контекст stream).
# Файл проекта ai-proxy в общем каталоге /etc/nginx/stream.d — один из потоковых
# блоков узла, лежит под собственным префиксом рядом с файлами других проектов.
#
# Устройство: маршрутизатор SNI на порту 443 направляет сюда трафик MTProxy.
# TLS is terminated here; decrypted stream forwarded to mtg daemon.

upstream mtproxy_tls_term {
    server 127.0.0.1:{{ mtproxy_tls_port | default(4443) }};
}

server {
    listen 127.0.0.1:{{ mtproxy_tls_port | default(4443) }} ssl proxy_protocol;

    ssl_certificate     /etc/nginx/ssl/mtproxy.crt;
    ssl_certificate_key /etc/nginx/ssl/mtproxy.key;
    ssl_protocols       TLSv1.3;

    proxy_pass 127.0.0.1:{{ mtproxy_local_port }};
    limit_conn aiproxy_transit {{ proxy_effective_max_connections | default(proxy_max_connections | default(96)) | int }};

    # Exceed mtg's 300s idle timeout; 60s races mobile Telegram keepalives.
    proxy_connect_timeout 10s;
    proxy_timeout 360s;
    proxy_buffer_size 4k;

    # TCP keepalive: detect dead peers via kernel probes
    proxy_socket_keepalive on;
}
