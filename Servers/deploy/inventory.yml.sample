---
# Полный образец параметров ai-proxy. Создать рабочий файл:
#   cp inventory.yml.sample inventory.yml
# inventory.yml целиком исключён из Git; реальные адреса и секреты задавайте в нём.
# Адреса ниже взяты из документационных диапазонов и требуют замены.
# Значения all.vars общие; vars группы и параметры узла переопределяют их.
# Закомментированные параметры необязательны: без них действует описанная автоматика.
# Включайте только нужные переопределения, сохраняя отступы YAML.
# Внутренние set_fact, результаты задач и факты Ansible не являются настройками.
all:
  children:
    # Клиентские точки входа: проверка пароля и выход через группу upstreams.
    access_proxies:
      hosts:
        access-01:
          # Адрес SSH; также источник адреса узла для ACL и межузлового трафика.
          ansible_host: 203.0.113.1
          # Начальное состояние VRRP; действует при enable_keepalived: true.
          keepalived_state: MASTER
          # Приоритет VRRP: большее значение предпочтительнее (1–254).
          keepalived_priority: 100
        access-02:
          # Адрес второго входного узла; должен быть уникальным.
          ansible_host: 203.0.113.2
          # Резервный участник той же VRRP-группы.
          keepalived_state: BACKUP
          # При отказе проверки Squid приоритет уменьшается на 20.
          keepalived_priority: 90
      vars:
        # access — клиентская точка входа; upstream — транспортный узел.
        proxy_role: access
        # Внешний порт Squid без nginx; при работе за nginx вход занят на 443.
        squid_port: 443
        # На access включает Basic Auth через локальный файл deploy/passwd.
        # false закрывает клиентский доступ целиком, а не разрешает анонимный.
        enable_auth: true
        # Журналы Squid; не управляет отдельным журналом SNI-маршрутизатора.
        enable_logging: true
        # Дисковый HTTP-кеш; содержимое сквозных TLS CONNECT не кешируется.
        enable_caching: true
        # Squid слушает loopback за общим nginx с PROXY protocol.
        # Без параметра учитываются MTProxy и обнаруженный nginx на 443.
        behind_nginx: true
        # Локальный порт Squid; общий SNI router использует фиксированный 3128.
        # При behind_nginx: true оставьте 3128, пока router не изменён согласованно.
        squid_local_port: 3128

        # Включает Keepalived/VRRP только на access при наличии keepalived_vip.
        enable_keepalived: false
        # Общий VIP пары access; должен поддерживаться сетью провайдера.
        keepalived_vip: 192.0.2.10
        # Длина сетевого префикса VIP, по умолчанию 24.
        keepalived_vip_prefix: 24
        # Интерфейс VRRP; без переопределения — ansible_default_ipv4.interface.
        # keepalived_interface: eth0
        # Идентификатор VRRP-группы (1–255), одинаковый у пары узлов.
        keepalived_vrid: 51
        # Пароль VRRP: задайте одинаковые 8 ASCII-символов при включении VRRP.
        keepalived_auth_pass: ""
        # Идентификатор маршрутизатора в журнале; можно переопределять на узле.
        keepalived_router_id: AI_PROXY_RU
        # Необязательный существующий исполняемый скрипт на узле; получает
        # аргумент master/backup/fault. Деплоймент сам скрипт не устанавливает.
        # keepalived_notify_script: /usr/local/sbin/notify-vrrp

    # Узлы выхода: Squid, DNS для access и MTProxy при его включении.
    upstreams:
      hosts:
        upstream-01:
          # Адрес SSH и межузлового назначения; разрешён firewall для access.
          ansible_host: 198.51.100.11
        upstream-02:
          # Второй выходной узел для балансировки и резервирования.
          ansible_host: 198.51.100.12
      vars:
        # Выбирает транспортную конфигурацию Squid и правила ограничения доступа.
        proxy_role: upstream
        # Порт назначения access → upstream; при MTProxy TLS идёт через nginx:443.
        squid_port: 443
        # Upstream принимает доверенные access без пользовательского пароля;
        # доступ ограничивается ACL и firewall, а исходный IP анонимизируется.
        enable_auth: false
        # Отключает журналы Squid и удаляет их остатки на upstream.
        enable_logging: false
        # На upstream дисковый кеш не нужен.
        enable_caching: false
        # Включает локальный Squid за общим маршрутизатором nginx.
        behind_nginx: true
        # Должен совпадать с портом fallback в общем SNI router: 3128.
        squid_local_port: 3128
        # Число неудачных подключений до исключения этого пира Squid (по умолчанию 2).
        connect_fail_limit: 2
        # Ожидание TCP-подключения к пиру в секундах (по умолчанию 5).
        connect_timeout: 5

  vars:
    # Учётная запись SSH; основной плейбук использует become: true.
    ansible_user: root
    # Интерпретатор Python на управляемых узлах.
    ansible_python_interpreter: /usr/bin/python3
    # Нестандартный порт SSH; по умолчанию Ansible использует 22.
    # ansible_port: 22
    # Путь к приватному SSH-ключу на управляющей машине (не содержимое ключа).
    # ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    # Метод повышения прав для SSH-пользователя без root; по умолчанию sudo.
    # ansible_become_method: sudo

    # Обновлять пакеты служб до доступной версии репозитория ОС (true)
    # либо только обеспечить установку (false). Обновление может перезапустить
    # службы и оборвать соединения. throttle: 1 ограничивает отдельные задачи,
    # но не обеспечивает последовательное обновление узлов целиком.
    # Общие nginx/CrowdSec обновляет согласованный владелец службы.
    # nftables автоматически не обновляется; mtg управляется mtproxy_version;
    # коллекции CrowdSec обновляются независимо от этого флага.
    service_upgrades_enabled: true

    # --- Память: все *_mb ниже заданы в МиБ (1 МиБ = 1048576 байт). ---
    # Цель — RAM/3, повышаемая до суммы минимумов/явных пределов включённых служб.
    # Жёсткий потолок — 1000000000 байт (1 ГБ, а не 1 ГиБ), далее вычитается
    # недоступная из-за резервов память. Полный план включает общий nginx,
    # CrowdSec и служебные процессы; cgroup v2 ограничивает RAM и запрещает swap.
    # Необязательный дополнительный потолок проекта; может только уменьшить бюджет.
    # Если потолок/резервы не вмещают минимумы, preflight остановит деплоймент.
    # proxy_memory_budget_mb: 400
    # Частичные фиксированные пределы служб; незаданные рассчитываются сами.
    # Приведены минимально допустимые значения, а не рекомендуемый фиксированный план.
    # Не раскомментируйте весь словарь, если нужна автоматическая адаптация.
    # proxy_memory_limits:
    #   # Squid: не менее 64 МиБ; число workers выводится из этого предела.
    #   squid: 64
    #   # Unbound: не менее 24 МиБ с учётом кешей и накладных расходов.
    #   unbound: 24
    #   # Общий nginx: не менее 48 МиБ; учитывайте соседние проекты.
    #   nginx: 48
    #   # mtg: не менее 32 МиБ, учитывается только на включённых upstream.
    #   mtg: 32
    #   # CrowdSec: не менее 192 МиБ, учитывается при crowdsec_enabled.
    #   crowdsec: 192
    #   # Firewall bouncer: не менее 24 МиБ, учитывается вместе с CrowdSec.
    #   crowdsec_bouncer: 24
    #   # Генератор энтропии haveged: не менее 8 МиБ.
    #   haveged: 8
    #   # Периодическая проверка Squid: не менее 8 МиБ.
    #   health: 8
    #   # Keepalived: не менее 12 МиБ, учитывается при включённом VRRP.
    #   keepalived: 12
    # Принудительно признать узел общим. Обнаружение чужих nginx-фрагментов
    # также включает этот признак; false не отменяет результат обнаружения.
    shared_host: false
    # Резерв ОС на выделенном узле: доля RAM, строго между 0 и 1.
    mem_reserve_share: 0.25
    # Резерв ОС на общем узле: доля RAM, строго между 0 и 1.
    mem_reserve_when_shared_share: 0.15
    # Абсолютный минимум резерва ОС (не менее 128); берётся максимум с долей выше.
    mem_system_min_mb: 128
    # Дополнительная верхняя доля ai-proxy на общем узле (0 < доля <= 1).
    # Не увеличивает RAM/3, потолок проекта и доступный после резервов объём.
    mem_share_when_shared: 1.0
    # Суммарный бюджет соседей. Берётся максимум из этого значения и найденных
    # MemoryMax чужих активных служб. Нужен явный ненулевой резерв, если чужое
    # приложение работает без MemoryMax; не удваивает уже обнаруженные лимиты.
    mem_foreign_reserved_mb: 0
    # Совместимые старые имена: перекрывают одноимённые элементы proxy_memory_limits.
    # Предпочитайте словарь выше; минимум CrowdSec — 192 МиБ.
    # crowdsec_memory_mb: 192
    # Совместимое старое имя предела bouncer, минимум 24 МиБ.
    # crowdsec_fw_bouncer_memory_mb: 24

    # --- Соединения и Squid. ---
    # Верхний предел транзитных сессий ai-proxy в nginx; не ограничивает Matrix.
    # Фактическая ёмкость может быть ниже из-за RAM и числа слотов nginx.
    proxy_max_connections: 96
    # Слоты соединений на worker общего nginx: не более 512 по preflight.
    # Сессия ai-proxy требует до четырёх слотов; нужен запас и для соседей.
    nginx_worker_connections: 512
    # FD на worker nginx: без настройки max(4096 * CPU, 65535).
    # Повышение не поднимает автоматически системный предел службы LimitNOFILE.
    # nginx_worker_rlimit_nofile: 65535
    # Минимальная допустимая версия установленного Squid, по умолчанию 5.7.
    # Параметр проверяет версию, но не устанавливает конкретный релиз пакета.
    squid_min_version: "5.7"
    # Простой CONNECT/ожидание данных Squid; отсчёт возобновляется при обмене.
    # Формат: целое число и seconds/minutes/hours/days/weeks.
    read_timeout: "1 hour"
    # Предел клиентского соединения Squid; обязан быть больше read_timeout.
    client_lifetime: "1 day"
    # Интервал повторной проверки недоступного пира Squid, по умолчанию 15 секунд.
    dead_peer_timeout: "15 seconds"
    # Локальный HTTP manager Squid для метрик и проверки готовности.
    squid_mgmt_port: 3129
    # Общий для таймера и VRRP минимальный интервал между рестартами Squid, секунды.
    keepalived_restart_cooldown: 30
    # Период ротации журналов Squid: daily/weekly/monthly (синтаксис logrotate).
    squid_log_rotate_period: daily
    # Число сохраняемых ротаций, по умолчанию 14; действует при enable_logging.
    squid_log_rotate_keep: 14
    # Разрешённые домены access-Squid: пусто вместе с patterns — все цели
    # для аутентифицированных клиентов. Пример ограничения: [".openai.com"].
    allowed_domains: []
    # Альтернативный allowlist regex для имени назначения; правила объединяются
    # с allowed_domains через ИЛИ. Пример: ['(^|\.)openai\.com$'].
    allowed_domain_patterns: []
    # Разрешает прямой выход с access при отказе всех upstream; раскрывает
    # целевому сервису IP access. false сохраняет запрет прямого выхода.
    allow_direct_fallback: false
    # Верхний срок положительных DNS-записей ВНУТРИ Squid, независимо от Unbound.
    squid_positive_dns_ttl: "6 hours"
    # Срок отрицательных ответов и нижняя граница положительных записей Squid.
    squid_negative_dns_ttl: "30 seconds"

    # --- TLS участка access → upstream. ---
    # Шифрует также CONNECT-заголовок с именем цели. Клиентский сквозной TLS
    # сам по себе этот заголовок не скрывает. По умолчанию true, в том числе
    # для старого inventory без параметра. Явное false оставляет участок открытым.
    squid_transit_tls: true
    # Общее имя SNI и сертификата участка; разрешение в публичном DNS не нужно.
    # Сертификат/ключ создаются на управляющей машине в игнорируемом deploy/tls/.
    squid_tls_sni: transit.internal
    # Loopback-порт TLS-терминатора Squid на upstream за SNI router при MTProxy.
    # Без такого маршрутизатора зашифрованный участок принимает сам Squid.
    squid_tls_term_port: 4444
    # Журнал общего SNI router; хранит IP и SNI независимо от enable_logging Squid.
    # Можно указать /dev/null; при CrowdSec тот же путь входит в источники журналов.
    sni_router_access_log: /var/log/nginx/sni-router.log
    # Буферизация журнала nginx: 32 КиБ, сброс раз в 5 секунд; false — без буфера.
    sni_router_log_buffered: true

    # --- DNS: Squid → local Unbound → upstream Unbound → публичные DNS. ---
    # Публичные форвардеры upstream Unbound (обычный DNS, не DNS-over-TLS).
    # Access получает список форвардеров из адресов группы upstreams.
    dns_servers:
      - 9.9.9.9
      - 8.8.8.8
      - 1.1.1.1
    # Дополнительные доверенные IPv4 DNS-клиенты сверх группы access_proxies;
    # одновременно расширяют ACL Unbound и правила firewall. Пример: [203.0.113.10].
    dns_extra_clients: []
    # Порт Unbound; весь плейбук использует фиксированный 53 в Squid/firewall
    # и форвардинге. Иное значение годится только для самостоятельной роли
    # после согласованной настройки потребителей; в полном деплойменте оставьте 53.
    dns_resolver_port: 53
    # Проверка DNSSEC с корневым ключом доверия Unbound.
    dns_resolver_dnssec: true
    # Фоновое обновление популярных записей до истечения TTL зоны.
    dns_resolver_prefetch: true
    # Потоки: автоматически min(CPU, max(MemoryMax / 64, 1)).
    # При явном значении проверяется бюджет 10*cache + 4*threads + 8 <= лимит Unbound.
    # dns_resolver_threads: 1
    # Базовая доля кеша, МиБ: msg=cache, rrset=2*cache, key=cache;
    # по умолчанию max(MemoryMax / 24, 1), с запасом на malloc и служебную память.
    # dns_resolver_cache_mb: 1

    # --- CrowdSec. ---
    # Разворачивает общий CrowdSec и nftables bouncer, включает их в бюджет.
    # Штатные коллекции не обеспечивают обнаружение перебора пароля Squid по 407.
    crowdsec_enabled: true

    # --- MTProxy: mtg на upstream, nginx relay на access. ---
    # Включает Telegram-тракт на обеих группах. Можно переопределить на узле;
    # если access включён, должен оставаться хотя бы один включённый upstream.
    mtproxy_enabled: true
    # Домен fake-TLS и основной ключ SNI; поддерживаемое умолчание — max.ru.
    # Домен должен совпадать на всех включённых upstream и с суффиксом секрета.
    mtproxy_fake_tls_domain: max.ru
    # Необязательное дополнительное имя SNI и адрес в выдаваемой Telegram-ссылке.
    # Укажите DNS-имя access/VIP; пусто — только fake-TLS SNI, а адрес ссылки
    # берётся из keepalived_vip при наличии, иначе из первой access-ноды.
    mtproxy_hostname: tgproxy.example.com
    # Версия mtg; изменение переключает бинарник и перезапускает службу.
    mtproxy_version: "2.2.8"
    # SHA-256 архива выбранной версии без префикса; пусто — без проверки хеша.
    # При разных архитектурах задавайте соответствующую сумму на каждом узле.
    mtproxy_sha256: ""
    # Количество прежних версий mtg для отката сверх действующей; 0 — не удалять.
    mtg_versions_keep: 0
    # Loopback-порт самого mtg на upstream.
    mtproxy_local_port: 2083
    # Loopback-порт TLS-терминатора nginx → mtg на upstream.
    mtproxy_tls_port: 4443
    # Loopback-порт nginx relay на access для шифрования межузлового участка.
    mtproxy_relay_port: 9443
    # Общий секрет: ee + 32 hex-символа ключа + hex ASCII-домена (max.ru:
    # 6d61782e7275). Пусто — сохранить единый найденный секрет из mtg.toml/env;
    # только при полном отсутствии создать один на кластер, с сохранением
    # энтропии на контроллере в deploy/secrets/mtproxy-entropy.
    # Разные существующие секреты не ротируются автоматически: нужен явный общий
    # mtproxy_secret. Изменение секрета/домена требует обновить ссылки клиентов.
    mtproxy_secret: ""
    # Общий предел одновременных сессий mtg, не на IP. Без настройки — 64;
    # пример просит 100. RAM/FD могут уменьшить фактическое значение в плане.
    mtproxy_max_connections: 100
    # Административный реестр выдачи общего секрета; не создаёт пользователей
    # и не отзывает доступ в mtg. Файл на upstream: /etc/mtproxy/users.txt.
    mtproxy_users:
      # Имя или понятный идентификатор получателя ссылки.
      - name: "Пример пользователя"
        # Контакт для рассылки ссылки после ручной ротации общего секрета.
        telegram: "@example_user"
        # Дата выдачи (строка YYYY-MM-DD), сама не ограничивает срок доступа.
        granted: "2026-10-18"
        # Произвольное административное примечание, не политика доступа.
        note: "Заменить локальной записью"
